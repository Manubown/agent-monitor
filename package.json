{
  "name": "agent-monitor",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Local dashboard for AI coding agent sessions (omp, Claude Code, Codex): cost, timelines, subagents, file and tool maps, full-text search",
  "license": "MIT",
  "author": "Manuel (https://github.com/Manubown)",
  "homepage": "https://github.com/Manubown/agent-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manubown/agent-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Manubown/agent-monitor/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "omp",
    "dashboard",
    "observability",
    "token-usage",
    "llm-cost",
    "session-logs",
    "local-first",
    "nextjs",
    "sqlite",
    "tantivy"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 4100",
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm build:native && node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 4100",
    "sync": "tsx src/cli.ts sync",
    "watch": "tsx src/cli.ts watch",
    "stats": "tsx src/cli.ts stats",
    "sources": "tsx src/cli.ts sources",
    "demo:data": "tsx scripts/demo.ts generate",
    "demo": "tsx scripts/demo.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm build:native && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
