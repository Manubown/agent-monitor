{
  "name": "agent-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Local monitoring dashboard for AI coding agent sessions (omp, Claude Code, Codex, ...)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4100",
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm build:native && next build",
    "start": "next start --hostname 127.0.0.1 --port 4100",
    "sync": "tsx src/cli.ts sync",
    "watch": "tsx src/cli.ts watch",
    "stats": "tsx src/cli.ts stats",
    "sources": "tsx src/cli.ts sources",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm build:native && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
